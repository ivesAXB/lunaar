# Copie para .env.local e preencha com os dados do projeto Supabase
# (Supabase → Project Settings → API). Sem estas variáveis o app roda em modo demonstração.

# Públicas (vão para o navegador; protegidas pelas regras de RLS do banco)
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=

# Somente no servidor (Vercel → Settings → Environment Variables). NUNCA use prefixo VITE_.
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
